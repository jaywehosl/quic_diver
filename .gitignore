# build
/bin/
/dist/
/qd-server
/qd-client
*.exe
*.dll
*.sys
*.test
*.out

# state / secrets
*.db
*.db-wal
*.db-shm
*.sqlite
/data/
*.pem
*.key
config.local.*

# go
/vendor/

# пропатченный quic-go (восстанавливается scripts/setup-third-party.sh)
/third_party/

# WinDivert вшивается в .exe (нужен в репо, несмотря на *.dll/*.sys выше)
!internal/packet/windivert/assets/WinDivert.dll
!internal/packet/windivert/assets/WinDivert64.sys
!bin/qd-server-linux-amd64

# боевой клиент с вшитым токеном — секрет, не в git
live-on-tests/*.exe

# Локальные настройки Claude Code: в них попадают разрешённые команды, а в них —
# админ-токены сети. У автора файл закрыт глобальным ~/.config/git/ignore, но в
# чужом клоне такой защиты нет.
.claude/settings.local.json

# Боевые сборки клиента и заметки по полевым тестам — не в публичный репозиторий.
/live-on-tests/
