+// QUIC Diver: диагностика потерь датаграмм. Дроп на приёме = потеря IP-пакета в
+// туннеле → TCP внутри видит потерю и рушит cwnd. Счётчики глобальные, читаются
+// из приложения (DatagramStats).
+var (
+	datagramsDropped atomic.Uint64
+	datagramsRcvd    atomic.Uint64
+)
+
+// DatagramStats возвращает число принятых и молча отброшенных (переполнение
+// очереди приёма) датаграмм.
+func DatagramStats() (received, dropped uint64) {
+	return datagramsRcvd.Load(), datagramsDropped.Load()
+}
+
 const (
-	maxDatagramSendQueueLen = 32
-	maxDatagramRcvQueueLen  = 128
+	// QUIC Diver: очереди под bulk-трафик, но НАМЕРЕННО небольшие.
+	// Upstream (32/128) рассчитан на редкие сигнальные датаграммы: send блокировал
+	// отправителя (stop-and-go), rcv молча дропал при burst. Раздувать тоже нельзя:
+	// длинная очередь = bufferbloat (пакет ждёт дренажа → RTT под нагрузкой растёт).
+	// Ориентир — покрыть burst обработки, а не BDP (за in-flight отвечает congestion).
+	maxDatagramSendQueueLen = 256
+	maxDatagramRcvQueueLen  = 1024
 )
 
